{
  "name": "omni-sdr-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:landing": "npm run dev --workspace=@omni/landing",
    "dev:web": "npm run dev --workspace=@omni/web",
    "dev:api": "npm run dev --workspace=@omni/api",
    "build": "npm run build:landing && npm run build:web && npm run build:api",
    "build:landing": "npm run build --workspace=@omni/landing",
    "build:web": "npm run build --workspace=@omni/web",
    "build:api": "npm run build --workspace=@omni/api",
    "start": "node apps/api/dist/server.js",
    "start:web": "npm run start --workspace=@omni/web",
    "lint": "eslint",
    "db:generate": "npm run db:generate --workspace=@omni/database",
    "db:push": "prisma db push --schema=packages/database/prisma/schema.prisma",
    "db:seed": "tsx packages/database/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "iron-session": "^9.0.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.4",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "postcss": "^8",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
